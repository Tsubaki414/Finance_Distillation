  "patterns": {
    "zh": [
      {
        "show": "不是X，而是Y",
        "regex": "(?<!是)不是[^。！？\\n]{1,30}?[，,、]?\\s*而是"
      },
      {
        "show": "不是X，是Y",
        "regex": "(?<!是)(?:并)?不是[^。！？\\n，,]{1,20}[，,]\\s*(?:真正)?是"
      },
      {
        "show": "与其说X，不如说Y",
        "regex": "与其说[^。！？\\n]{1,30}不如说"
      },
      {
        "show": "真正的问题/关键/信号是",
        "regex": "真正(?:的)?(?:问题|关键|信号|变量|看点)(?:在于|是)"
      },
      {
        "show": "说白了 / 说到底 / 一句话：",
        "regex": "说白了|说到底|一句话[：:]"
      },
      {
        "show": "这才是…的地方",
        "regex": "这才是[^。！？\\n]{1,30}的地方"
      },
      {
        "show": "元延续开头（延续此前判断 / 接着上次 / 正如我之前说）",
        "regex": "延续(?:此前|之前|前期|上次|先前)的?(?:判断|观点|观察|看法|思路)|接着上次|正如我?(?:之前|此前|上次|前面)所?(?:说|讲|提到)|我(?:之前|此前|上次)就?(?:说过|提过|讲过)|如前(?:文|期)?所述|重申(?:此前|之前)的?(?:判断|观点)"
      }
    ],
    "en": [
      {
        "show": "X isn't A — it's B",
        "regex": "\\b(?:is|was|are)n[’']?t\\b[^.!?\\n]{1,60}?(?:—|–|-{1,2}|;|,)\\s*(?:it[’']?s|they[’']?re|this is)\\b"
      },
      {
        "show": "not X but Y",
        "regex": "\\bnot (?:just |only |about )?[^.!?\\n,]{1,40},? but\\b"
      },
      {
        "show": "it's not about X",
        "regex": "\\b(?:it|this)[’']?s not about\\b|\\bisn[’']?t about\\b"
      },
      {
        "show": "the real story/question/tell; here's the thing; make no mistake",
        "regex": "\\bthe real (?:story|question|tell|signal|issue)\\b|\\bhere[’']?s the thing\\b|\\bmake no mistake\\b"
      },
      {
        "show": "meta-continuation opener (Continuing the… / Following up on… / As I said…)",
        "regex": "\\b(?:continuing (?:from|with|on) (?:my|our|the) (?:earlier|prior|previous|last)\\b|continuing (?:the|my|our) (?:earlier |prior |previous )?(?:expectation|view|call|thesis|argument|read|take)\\b|following up (?:on|from)\\b|building on (?:my|our|the) (?:earlier|prior|previous|last)\\b|as i (?:said|noted|argued|flagged|wrote|mentioned)\\b|as (?:previously|earlier) (?:noted|flagged|said|argued)\\b|to reiterate\\b)"
      }
    ]
  },
